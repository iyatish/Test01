---
import Base from './Base.astro';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---
<Base title={title} description={description}>
  <article class="post-article">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <span class="updated">· Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
        )}
      </div>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map(tag => (
            <li><a href={`/tags/${tag}`} class="tag">{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/" class="back-link">← All posts</a>
    </footer>
  </article>
</Base>

<style>
  .post-article {
    padding: 3rem 0 2rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--text-faint);
    margin-bottom: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .updated {
    color: var(--text-faint);
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: var(--accent);
  }
</style>
